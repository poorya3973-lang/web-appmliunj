{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appmliunj",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f485b3cb-ee29-4876-a152-d89356de55fc","database_name": "web-appkjnuhy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0ca3910459ce42bebe38061b61fadcd1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
